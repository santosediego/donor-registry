# Troubleshooting (sintomas quando falta variável):
#   'url' must start with "jdbc"                  -> falta DB_URL
#   erro de autenticação no banco (perfil prod)   -> confira DB_USERNAME e DB_PASSWORD
#
# Copy to backend/.env and fill in with your local values. Never commit .env.
APP_PROFILE=dev
DB_URL=jdbc:postgresql://localhost:5432/donor_registry_dev
DB_USERNAME=
DB_PASSWORD=
